{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "matchPackagePatterns": [
        "glib",
        "gstreamer-*",
        "gstreamer"
      ],
      "groupName": "gstreamer-rs",
      "groupSlug": "gstreamer-rs"
    },
    {
      "matchPackagePatterns": [
        "opentalk-types*"
      ],
      "groupName": "opentalk-controller",
      "groupSlug": "opentalk-controller"
    }
  ]
}
