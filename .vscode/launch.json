    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'compositor'",
            "cargo": {
                "args": [
                    "test",
                    //"--jobs=1",
                    "--lib",
                    "--package=compositor"
                ],
                "filter": {
                    "name": "compositor",
                    "kind": "lib"
                },
                "env": {
                    "GST_DEBUG": "2",
                    "GST_DEBUG_DUMP_DOT_DIR": "${workspaceFolder}/compositor/pipelines",
                    "RUST_LOG": "debug"
                },
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
    ]
}