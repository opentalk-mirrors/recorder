{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Compositor",
            "relativePathBase": "compositor",
            "cargo": {
                "args": [
                    "build",
                    "--bin=compositor",
                    "--package=compositor",
                    "--manifest-path=${workspaceFolder}/compositor/Cargo.toml"
                ],
                "filter": {
                    "name": "compositor",
                    "kind": "bin"
                }
            },
            "args": [],
            "env": {
                "GST_DEBUG_DUMP_DOT_DIR": "${workspaceFolder}/compositor/pipelines",
                "RUST_LOG": "trace"
            },
            "cwd": "${workspaceFolder}/compositor"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug Compositor Display",
            "relativePathBase": "compositor",
            "cargo": {
                "args": [
                    "build",
                    "--bin=compositor",
                    "--package=compositor",
                    "--manifest-path=${workspaceFolder}/compositor/Cargo.toml"
                ],
                "filter": {
                    "name": "compositor",
                    "kind": "bin"
                }
            },
            "args": [
                "-D",
                "-t",
                "-d",
                "-p",
                "80",
                "-v",
                "80",
                "-l",
                "grid"
            ],
            "env": {
                "GST_DEBUG": "4",
                "GST_DEBUG_DUMP_DOT_DIR": "${workspaceFolder}/compositor/pipelines",
                "RUST_LOG": "trace"
            },
            "cwd": "${workspaceFolder}/compositor"
        }
    ]
}