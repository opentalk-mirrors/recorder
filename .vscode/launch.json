{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug",
            "cargo": {
                "args": [
                    "build",
                    "--bin=opentalk-recorder",
                    "--package=opentalk-recorder"
                ],
                "filter": {
                    "name": "opentalk-recorder",
                    "kind": "bin"
                },
                "env": {
                    "GST_DEBUG_DUMP_DOT_DIR": "${workspaceFolder}/compositor/pipelines",
                    "RUST_LOG": "trace,rustls=info,tungstenite=error,tokio_tungstenite=error,opentalk_recorder::signaling=debug",
                    "RUST_BACKTRACE": "3",
                    "GST_DEBUG": "1"
                },
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug unit tests in library 'compositor'",
            "cargo": {
                "args": [
                    "test",
                    //"--jobs=1",
                    "--lib",
                    "--package=compositor"
                ],
                "filter": {
                    "name": "compositor",
                    "kind": "lib"
                },
                "env": {
                    "GST_DEBUG": "2",
                    "GST_DEBUG_DUMP_DOT_DIR": "${workspaceFolder}/compositor/pipelines",
                    "RUST_LOG": "debug"
                },
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
    ]
}